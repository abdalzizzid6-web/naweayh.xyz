# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The official domain URL for production.
APP_URL="https://naweayh.xyz"

# DATABASE_URL: Required for Production - PostgreSQL connection string (Neon / Supabase / Vercel Postgres / Cloud SQL)
DATABASE_URL="postgresql://user:password@ep-example.us-east-1.aws.neon.tech/naw3iya_db?sslmode=require"

# JWT_SECRET: Required 256-bit cryptographically secure secret for JWT token signing in production
JWT_SECRET=""

# ADMIN_EMAIL & ADMIN_INITIAL_PASSWORD: For secure auto-provisioning of primary Super Admin on first run
ADMIN_EMAIL="admin@naweayh.xyz"
ADMIN_INITIAL_PASSWORD=""

# CRON_SECRET: Secret key to authorize Vercel Cron jobs & background workers
CRON_SECRET=""

# REDIS_URL: Redis Cloud URL for caching & message queues (optional)
REDIS_URL=""

# Social Network API Credentials (optional)
X_API_KEY=""
TELEGRAM_BOT_TOKEN=""
FACEBOOK_PAGE_ACCESS_TOKEN=""


